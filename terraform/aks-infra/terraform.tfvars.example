# Copy to terraform.tfvars (gitignored) and fill in.
budget_alert_email = "you@example.com"

# From: terraform -chdir=../container-registry output -raw acr_id
# (apply container-registry/ first)
acr_id = ""

# Uncomment to override any other default from variables.tf, e.g.:
# node_count   = 1
# node_vm_size = "Standard_B2ms"
# Region is no longer set here -- it comes from the shared resource group
# created by container-registry/ (override its `location` variable instead).
