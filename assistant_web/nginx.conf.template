server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxies the backend instead of the frontend JS bundle calling an
    # absolute host/IP -- that baked-in-URL approach breaks the moment this
    # runs anywhere other than the exact host/IP it was built for. BACKEND_HOST
    # (and BACKEND_PORT) are substituted at container start (nginx's built-in
    # envsubst-on-templates mechanism); docker-compose sets BACKEND_HOST=backend,
    # the Helm chart sets it to the backend Service's DNS name.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
